# ============================================================
# ModLink MCP — Environment Variables
# Copy this file to .env and fill in all values
# ============================================================

# --- Discord ---
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Application / Client ID from Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
# Client Secret from Discord Developer Portal -> OAuth2
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
# Callback URL registered in Discord Developer Portal (optional, defaults to [HOST]/auth/discord/callback)
# DISCORD_REDIRECT_URI=https://your-service.onrender.com/auth/discord/callback

# --- Database ---
# Supabase PostgreSQL (Production):
# Copy from Supabase Project Settings -> Database -> Connection string (URI)
# e.g.: postgresql://postgres.[project-ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./modlink.db

# --- MCP Gateway ---
# The public HTTPS URL where this MCP server is reachable
MCP_PUBLIC_URL=https://mcp.yourdomain.com/mcp

# Host/port the MCP HTTP server binds to (internal)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- OIDC / OAuth 2.1 (token-introspection) ---
# Leave blank to use the simpler API-key auth in development
OIDC_ISSUER_URL=https://identity.yourdomain.com/realms/modlink
OIDC_INTROSPECTION_URL=https://identity.yourdomain.com/realms/modlink/protocol/openid-connect/token/introspect
OIDC_CLIENT_ID=modlink-resource-server
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Secret used to sign dashboard session tokens
DASHBOARD_SECRET=CHANGE_ME_RANDOM_32_CHARS

# --- Redis (optional, for distributed AutoMod state) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
